#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."

export DEBIAN_FRONTEND=noninteractive
browsers="$HOME/.cache/workblock/browsers"

step() {
  local name=$1 start=$SECONDS
  shift
  echo "==> $name"
  "$@"
  echo "<== $name ($((SECONDS - start))s)"
}

can_sudo() { command -v sudo >/dev/null 2>&1 && sudo -n true >/dev/null 2>&1; }

node_runtime() {
  local major="" arch node_arch work tarball
  command -v node >/dev/null 2>&1 && major=$(node -p 'process.versions.node.split(".")[0]')
  [ -n "$major" ] && [ "$major" -ge 22 ] && return
  can_sudo || { echo "setup: Node 22 or later is missing and sudo is unavailable" >&2 && return 1; }
  arch=$(uname -m)
  case $arch in
    x86_64) node_arch=x64 ;;
    aarch64) node_arch=arm64 ;;
    *) echo "setup: unsupported architecture $arch" >&2 && return 1 ;;
  esac
  work=$(mktemp -d)
  curl -fsSL https://nodejs.org/dist/latest-v24.x/SHASUMS256.txt -o "$work/SHASUMS256.txt"
  tarball=$(awk -v arch="$node_arch" '$2 ~ ("^node-v24\\..*-linux-" arch "\\.tar\\.xz$") { print $2; exit }' "$work/SHASUMS256.txt")
  [ -n "$tarball" ] || { echo "setup: no Node 24 tarball for $node_arch" >&2 && rm -rf "$work" && return 1; }
  curl -fsSL "https://nodejs.org/dist/latest-v24.x/$tarball" -o "$work/$tarball"
  (cd "$work" && grep -F "  $tarball" SHASUMS256.txt | sha256sum -c -)
  sudo tar -xJf "$work/$tarball" -C /usr/local --strip-components=1
  rm -rf "$work"
  hash -r
}

xvfb() {
  command -v xvfb-run >/dev/null 2>&1 && return
  can_sudo || { echo "setup: xvfb-run is missing and sudo is unavailable" >&2 && return 1; }
  sudo apt-get update
  sudo apt-get install -y --no-install-recommends xvfb xauth
}

chrome() {
  local path
  path=$(npx -y @puppeteer/browsers@3.2.4 install chrome@stable --path "$browsers" --format '{{path}}' | tail -n1)
  if ! "$path" --version >/dev/null 2>&1 && can_sudo; then
    sudo env "PATH=$PATH" npx -y @puppeteer/browsers@3.2.4 install chrome@stable --path "$browsers" --install-deps >/dev/null
  fi
  "$path" --version
  # Ubuntu 24.04's AppArmor blocks the user namespaces Chrome's sandbox needs ("No usable sandbox!"). CI lifts it too.
  local userns=/proc/sys/kernel/apparmor_restrict_unprivileged_userns
  if [ "$(cat "$userns" 2>/dev/null)" = 1 ] && can_sudo; then
    sudo sysctl -w kernel.apparmor_restrict_unprivileged_userns=0
  fi
}

demo_tools() {
  command -v ffmpeg >/dev/null 2>&1 && command -v magick >/dev/null 2>&1 && return
  can_sudo || { echo "setup: ffmpeg or magick is missing and sudo is unavailable" >&2 && return 1; }
  sudo apt-get update
  sudo apt-get install -y --no-install-recommends ffmpeg imagemagick
  command -v magick >/dev/null 2>&1 || { echo "setup: the imagemagick package has no magick command, so npm run demo needs ImageMagick 7" >&2 && return 1; }
}

chrome_or_warn() {
  chrome || echo "setup: no Chrome for Testing yet, so npm run e2e needs a Chromium path" >&2
}

export PATH="/usr/local/bin:$PATH"
step 'node 22 or later' node_runtime
step 'xvfb' xvfb
step 'chrome for testing' chrome_or_warn
step 'ffmpeg and imagemagick for demo' demo_tools || echo "setup: npm run demo needs ffmpeg and magick" >&2
