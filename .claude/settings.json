{
  "permissions": {
    "allow": [
      "Bash(npm run ship)",
      "Bash(npm run prune)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$CLAUDE_CODE_REMOTE\" != true ] || bash \"$CLAUDE_PROJECT_DIR/.agents/setup\" >&2"
          }
        ]
      }
    ]
  }
}
